---
/**
 * BUSCA DO BLOG.
 *
 * Pagina estatica que carrega /blog/indice-de-busca.json e filtra no
 * navegador. Existe porque o site sobe como build estatico: sem servidor, o
 * /blog?q= do prototipo em HTML nao teria quem responder.
 *
 * NOINDEX, FOLLOW e canonical para /blog. URL de busca indexavel e fabrica de
 * pagina fina, e o robots.txt tambem bloqueia /blog/busca por rastreamento.
 *
 * Sem JavaScript a pagina explica o que fazer e oferece a navegacao por
 * categoria, que cobre o mesmo conteudo.
 */
import BlogLayout from '../../layouts/BlogLayout.astro';
import Icon from '../../components/layout/Icon.astro';
import { categories } from '../../data/categories';
import { site } from '../../data/site';
---

<BlogLayout
  title={`Busca no blog | ${site.name}`}
  description="Busque nos artigos do blog do SEO Maroto por termo, erro do Search Console ou nome de ferramenta."
  path="/blog"
  noindex
  activeCategory="tudo"
>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">busca</span>
        <h2>Procurando algo específico?</h2>
      </div>

      <form class="search-form busca-form" action="/blog/busca" method="get" role="search">
        <div class="row">
          <div class="field">
            <Icon set="ui" name="search" strokeWidth={2} />
            <label class="sr-only" for="q">Buscar no blog</label>
            <input id="q" type="search" name="q" placeholder="core web vitals, canonical, llms.txt..." autocomplete="off" />
          </div>
          <button class="btn btn-primary" type="submit">Buscar</button>
        </div>
      </form>

      <p class="busca-status" role="status" aria-live="polite"></p>
      <ul class="busca-lista" id="busca-lista"></ul>

      <noscript>
        <p class="busca-sem-js">A busca precisa de JavaScript. Sem ele, navegue pelas categorias:</p>
      </noscript>

      <div class="busca-categorias">
        {categories.map((c) => (
          <a class:list={['cat-tag', c.variant === 'rust' && 'rust']} href={`/blog/categoria/${c.slug}`}>{c.name}</a>
        ))}
      </div>
    </div>
  </section>
</BlogLayout>

<script>
  import { initBuscaBlog } from '../../scripts/busca-blog';
  initBuscaBlog();
</script>

<style is:global>
.busca-form{ max-width:620px; margin-top:8px; }
.busca-status{ font-family: var(--mono); font-size:12.5px; color: var(--text-muted); margin-top:20px; min-height:19px; }
.busca-lista{ display:flex; flex-direction:column; gap:4px; margin-top:8px; }
.busca-lista li{ border-bottom:1px solid var(--border); }
.busca-lista a{ display:flex; flex-direction:column; gap:5px; padding:18px 4px; }
.busca-lista a:hover h3{ color: var(--accent-ink); }
.busca-lista h3{ font-size:16.5px; font-weight:600; line-height:1.35; }
.busca-lista p{ font-size:13.5px; line-height:1.6; color: var(--text-secondary); }
.busca-lista .bl-meta{ display:flex; align-items:center; gap:8px; font-family: var(--mono); font-size:11px; color: var(--text-muted); }
.busca-sem-js{ font-size:14px; color: var(--text-secondary); margin-top:20px; }
.busca-categorias{ display:flex; flex-wrap:wrap; gap:8px 18px; margin-top:34px; padding-top:22px; border-top:1px solid var(--border); }
</style>
