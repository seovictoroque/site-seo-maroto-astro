---
/**
 * PAGINA 404.
 *
 * O .htaccess em public/ aponta o ErrorDocument para /404/index.html, entao
 * o Apache da Hostinger serve esta pagina no lugar da tela padrao dele.
 *
 * Nasce noindex: pagina de erro indexada e ruido no relatorio de cobertura.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/layout/Icon.astro';
import { categories } from '../data/categories';
import { site } from '../data/site';
---

<BaseLayout
  title={`Página não encontrada | ${site.name}`}
  description="A página que você procurou não existe ou mudou de endereço."
  path="/404"
  noindex
>
  <main id="conteudo" class="erro">
    <div class="wrap">
      <p class="erro-code">404</p>
      <h1>Essa página não existe, ou mudou de endereço</h1>
      <p class="erro-sub">Acontece. Link antigo, endereço digitado errado, ou conteúdo que saiu do ar. Abaixo estão os caminhos que resolvem a maior parte dos casos.</p>

      <div class="erro-acoes">
        <a class="btn btn-primary" href="/blog">
          Ir para o blog
          <Icon set="ui" name="arrow" strokeWidth={2.2} />
        </a>
        <a class="btn btn-ghost" href="/blog/busca">Buscar um artigo</a>
      </div>

      <p class="erro-cats">Ou escolha uma categoria:</p>
      <div class="erro-lista">
        {categories.map((c) => (
          <a href={`/blog/categoria/${c.slug}`}>{c.name}</a>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<style is:global>
.erro{ display:flex; align-items:center; padding:90px 0 120px; }
.erro .wrap{ max-width:720px; }
.erro-code{ font-family: var(--mono); font-size:13px; letter-spacing:0.2em; color: var(--accent); }
.erro h1{ font-family: var(--serif); font-weight:400; font-style:italic; font-size: clamp(32px,5vw,46px); line-height:1.1; margin:14px 0 16px; }
.erro-sub{ font-size:15.5px; line-height:1.72; color: var(--text-secondary); max-width:560px; }
.erro-acoes{ display:flex; gap:12px; flex-wrap:wrap; margin-top:30px; }
.erro .btn{ display:inline-flex; align-items:center; justify-content:center; gap:8px; border-radius:9px; padding:12px 22px; font-size:14px; font-weight:600; border:1px solid transparent; }
.erro .btn svg{ width:16px; height:16px; }
.erro .btn-primary{ background: var(--accent); color:#2B1704; border-color: var(--accent); }
.erro .btn-primary:hover{ background:#E6B75E; }
.erro .btn-ghost{ background: var(--bg-elev); color: var(--text-primary); border-color: var(--border-strong); }
.erro .btn-ghost:hover{ background: var(--bg-elev-2); color: var(--accent); }
.erro-cats{ font-family: var(--mono); font-size:11.5px; text-transform:uppercase; letter-spacing:0.1em; color: var(--text-muted); margin-top:44px; }
.erro-lista{ display:flex; flex-wrap:wrap; gap:8px; margin-top:14px; }
.erro-lista a{ font-size:13px; color: var(--text-secondary); border:1px solid var(--border); border-radius:20px; padding:7px 14px; transition: color .15s ease, border-color .15s ease; }
.erro-lista a:hover{ color: var(--accent); border-color: var(--border-strong); }
</style>
