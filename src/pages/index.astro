---
/**
 * HOME DO SITE, variante focada em Escolinha SEO e roadmap.
 *
 * Secoes, na ordem:
 * 1. Hero com o cartao de progresso do roteiro de 12 etapas
 * 2. Numeros do projeto
 * 3. Escolinha SEO, as tres trilhas
 * 4. Roadmap, as 12 etapas em tres colunas
 * 5. Ultimos textos do blog
 * 6. Estudos de caso com antes e depois
 * 7. Bloco GEO/AEO, unico lugar onde o rust manda no visual
 * 8. Sobre o Victor
 * 9. Newsletter
 * 10. FAQ com acordeao e melhoria progressiva
 *
 * O QUE MUDOU EM RELACAO A HOME ANTERIOR
 * Saiu o hero com campo de URL do SEO Audit e saiu a secao inteira de
 * ferramentas. A entrada da pagina passou a ser o aprendizado, nao o
 * diagnostico. As ferramentas continuam no menu e no rodape do roadmap.
 *
 * ATENCAO, CONTEUDO DE EXEMPLO
 * Numeros, cases e depoimentos vieram do prototipo em HTML marcados com o
 * comentario TROCAR. Sao placeholders plausiveis, nao dados reais.
 *
 * O FAQ e acordeao com melhoria progressiva: sem JavaScript todas as
 * respostas ficam abertas e a pagina continua legivel. O acordeao visivel e
 * o FAQPage do JSON-LD saem da MESMA lista `faq` abaixo.
 *
 * O cartao de progresso tambem e melhoria progressiva: nasce com o valor
 * estatico de src/data/roadmap.ts e o roadmap-progress.ts atualiza depois,
 * se houver progresso gravado no navegador.
 *
 * A home usa o tema escuro e tem primitivos proprios (.section, .eyebrow,
 * .btn) com valores diferentes dos do blog. Por isso ela NAO carrega
 * blog-primitives.css: o CSS dela e src/styles/pages/home.css.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/layout/Icon.astro';
import ProgressCard from '../components/home/ProgressCard.astro';
import RoadmapStages from '../components/home/RoadmapStages.astro';
import { site } from '../data/site';
import { authors } from '../data/authors';
import { faqNode, personNode } from '../lib/schema';
import { allPosts, formatDate } from '../lib/posts';
import { getCategory } from '../data/categories';
import { etapasRoadmap } from '../data/roadmap';
import '../styles/pages/home.css';

const faq = [
  {
    "question": "As ferramentas são gratuitas mesmo, ou tem pegadinha?",
    "answer": "Gratuitas e sem cadastro. Você roda, vê o resultado na tela e vai embora se quiser. O código da maioria delas está aberto no GitHub, então dá para conferir o que cada uma faz com os seus dados, que é nada além de processar e devolver."
  },
  {
    "question": "Preciso saber programar para seguir a Escolinha SEO?",
    "answer": "Na trilha iniciante, não. Na trilha técnica, ajuda muito ler HTML e entender uma requisição HTTP, mas o conteúdo explica o necessário no caminho. Ninguém precisa virar dev, só parar de tratar o navegador como caixa preta."
  },
  {
    "question": "GEO e AEO substituem o SEO tradicional?",
    "answer": "Não. A base continua a mesma: o conteúdo precisa ser rastreável, indexável, rápido e confiável. O que muda é o formato da resposta e a forma de medir, porque citação em modelo de linguagem não aparece no relatório de clique. É uma camada nova, não uma troca de profissão."
  },
  {
    "question": "Você presta consultoria ou só publica conteúdo?",
    "answer": "Atendo poucos projetos por vez, em consultoria técnica e treinamento para time interno. O melhor começo é um bate-papo de 30 minutos, sem apresentação comercial: você conta o problema e eu digo se consigo ajudar ou se o caso é de outra pessoa."
  },
  {
    "question": "Por que os estudos de caso não citam o nome dos clientes?",
    "answer": "Parte dos projetos tem contrato de confidencialidade. Quando o nome pode aparecer, ele aparece. Quando não pode, o caso descreve o segmento, o tamanho do site e o número real, que é o que interessa para você reproduzir o método."
  }
];

const victor = authors[0];
const totalEtapas = etapasRoadmap.length;

// os tres textos mais recentes, direto da collection
const ultimosPosts = (await allPosts()).slice(0, 3);
---

<BaseLayout
  title="SEO Maroto, o roteiro completo para virar profissional de SEO"
  description="Roteiro gratuito e aberto de SEO em 12 etapas, das três trilhas de estudo ao GEO/AEO. Marque seu progresso, sem cadastro e sem curso de cinco mil reais no final."
  path="/"
  ogTitle="SEO Maroto, o roteiro completo para virar profissional de SEO"
  ogDescription="Roteiro de SEO em 12 etapas, três trilhas de estudo e estudos de caso com número na mesa."
  schema={[personNode(victor), faqNode('/', faq)]}
>
<main id="conteudo">
<!-- 1. HERO ================================================================ -->
<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <span class="eyebrow">escolinha seo, roteiro aberto</span>
      <h1>O roteiro completo para virar <em>profissional de SEO</em>.</h1>
      <p class="hero-sub">{totalEtapas} etapas, do fundamento técnico até GEO/AEO, na ordem em que as coisas fazem sentido de verdade. Você marca o que já sabe e o progresso fica salvo no seu navegador.</p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="/escolinha-seo">Começar do zero
          <Icon set="ui" name="arrow" strokeWidth={2.2} />
        </a>
        <a class="btn btn-ghost" href="/escolinha-seo/tecnica">Já sei o básico, pular para a técnica</a>
      </div>
      <p class="hero-note">Gratuito, sem cadastro, sem e-mail obrigatório. Código do roteiro aberto no GitHub.</p>
    </div>

    <ProgressCard />
  </div>
</section>

<!-- 2. NUMEROS ============================================================= -->
<!-- TROCAR, numeros de exemplo. Ajustar antes de publicar. -->
<section class="section" aria-label="O projeto em números">
  <div class="wrap">
    <div class="numbers">
      <div class="num-cell"><div class="n">{totalEtapas}</div><div class="l">etapas no roteiro<br>do zero ao avançado</div></div>
      <div class="num-cell"><div class="n">60+</div><div class="l">itens de ação<br>com material aberto</div></div>
      <div class="num-cell"><div class="n">47</div><div class="l">experimentos publicados<br>com metodologia aberta</div></div>
      <div class="num-cell"><div class="n">R$&nbsp;0</div><div class="l">de curso, funil<br>ou mentoria escondida</div></div>
    </div>
  </div>
</section>

<!-- 3. ESCOLINHA =========================================================== -->
<section class="section" aria-labelledby="h-escolinha">
  <div class="wrap">
    <div class="head-row">
      <div class="section-head">
        <span class="eyebrow">escolinha seo</span>
        <h2 id="h-escolinha">A trilha para virar profissional de SEO</h2>
        <p>Roteiro gratuito e de código aberto, em três etapas, na ordem em que as coisas fazem sentido de verdade.</p>
      </div>
      <a class="link-more" href="/escolinha-seo">ver o roteiro inteiro
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>

    <div class="trails">
      <div class="trail">
        <span class="trail-step">etapa 01</span>
        <h3>Iniciante</h3>
        <p>Como a busca funciona por dentro, antes de mexer em qualquer coisa. Sem isso, o resto vira chute com nome bonito.</p>
        <div class="trail-nodes"><span>rastreamento</span><span>indexação</span><span>intenção de busca</span><span>on-page</span><span>métricas</span></div>
        <a class="btn btn-ghost" href="/escolinha-seo/iniciante">Começar do zero</a>
      </div>
      <div class="trail">
        <span class="trail-step">etapa 02</span>
        <h3>Técnica</h3>
        <p>Onde o SEO deixa de ser palpite e vira engenharia. Log, render, arquitetura de informação e performance.</p>
        <div class="trail-nodes"><span>análise de log</span><span>JavaScript SEO</span><span>Core Web Vitals</span><span>schema</span><span>internacional</span></div>
        <a class="btn btn-ghost" href="/escolinha-seo/tecnica">Ir para a técnica</a>
      </div>
      <div class="trail ai">
        <span class="trail-step">etapa 03</span>
        <h3>GEO e AEO</h3>
        <p>O que muda quando a resposta é gerada e não listada. Entidades, citabilidade e conteúdo que a máquina consegue reaproveitar.</p>
        <div class="trail-nodes"><span>entidades</span><span>citabilidade</span><span>AI Overviews</span><span>llms.txt</span><span>medição</span></div>
        <a class="btn btn-rust" href="/escolinha-seo/geo-aeo">Entrar no GEO/AEO</a>
      </div>
    </div>
  </div>
</section>

<!-- 4. ROADMAP ============================================================= -->
<section class="section" aria-labelledby="h-roadmap">
  <div class="wrap">
    <div class="head-row">
      <div class="section-head">
        <span class="eyebrow">roadmap</span>
        <h2 id="h-roadmap">As {totalEtapas} etapas, na ordem</h2>
        <p>O mapa inteiro numa tela. Cada etapa abre com os itens de ação e o material de estudo, e o que você marcar fica salvo.</p>
      </div>
      <a class="link-more" href="/escolinha-seo">abrir o roadmap interativo
        <Icon set="ui" name="arrow" strokeWidth={2.2} />
      </a>
    </div>

    <RoadmapStages />

    <div class="rm-foot">
      <p>Toda etapa que pede ferramenta tem uma versão gratuita aqui, sem cadastro.</p>
      <a class="btn btn-ghost" href="/ferramentas">Ver as 10 ferramentas</a>
    </div>
  </div>
</section>

<!-- 5. BLOG ================================================================ -->
<section class="section" aria-labelledby="h-blog">
  <div class="wrap">
    <div class="head-row">
      <div class="section-head">
        <span class="eyebrow">no blog</span>
        <h2 id="h-blog">O que saiu por último</h2>
        <p>Texto técnico com teste por trás. Quando não deu certo, o post fala que não deu certo.</p>
      </div>
      <a class="link-more" href="/blog">todos os textos
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>

    {/* Os tres cards vinham escritos a mao no prototipo em HTML, apontando
        para posts que nunca existiram. Agora saem da collection, entao a home
        nunca mais linka para um artigo que nao foi publicado. O markup e o
        .post-card DA HOME, que tem CSS proprio e e diferente do card do blog. */}
    <div class="post-grid">
      {ultimosPosts.map((post) => {
        const cat = getCategory(post.data.category);
        return (
          <a class:list={['post-card', cat?.variant === 'rust' && 'ai']} href={`/blog/${post.id}`}>
            <span class="post-cat">{cat?.name}</span>
            <h3>{post.data.title}</h3>
            {post.data.excerpt && <p>{post.data.excerpt}</p>}
            <span class="post-meta">
              <span>{formatDate(post.data.publishDate)}</span>
              <span>{post.data.readingTime} min</span>
            </span>
          </a>
        );
      })}
    </div>
  </div>
</section>

<!-- 6. ESTUDOS DE CASO ===================================================== -->
<!-- TROCAR, cases de exemplo. Numeros precisam vir de projeto real. -->
<section class="section" aria-labelledby="h-cases">
  <div class="wrap">
    <div class="head-row">
      <div class="section-head">
        <span class="eyebrow">estudos de caso</span>
        <h2 id="h-cases">Número na mesa, método aberto</h2>
        <p>Sempre no mesmo formato: problema, diagnóstico, hipótese, implementação, resultado e o que eu aprendi errando.</p>
      </div>
      <a class="link-more" href="/cases">todos os casos
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>

    <div class="case-grid">
      <a class="case-card" href="/cases/marketplace-indexacao">
        <span class="case-seg">marketplace, 400 mil URLs</span>
        <h3>De 12% para 71% de páginas indexadas em cinco meses</h3>
        <div class="case-delta"><span>12%</span><span aria-hidden="true">&rsaquo;</span><span class="to">71%</span></div>
        <p>O sitemap listava tudo, o servidor respondia 200 em página vazia e o Google desistiu. A saída foi cortar o inventário, não aumentar.</p>
        <span class="link-more">ler o caso completo</span>
      </a>
      <a class="case-card" href="/cases/saas-b2b-receita-organica">
        <span class="case-seg">SaaS B2B, ticket alto</span>
        <h3>Menos tráfego, 2,3x mais receita vinda do orgânico</h3>
        <div class="case-delta"><span>1x</span><span aria-hidden="true">&rsaquo;</span><span class="to">2,3x</span></div>
        <p>Cortamos 140 posts de topo de funil que não convertiam nada e realocamos o esforço em 20 páginas de comparação e alternativa.</p>
        <span class="link-more">ler o caso completo</span>
      </a>
      <a class="case-card" href="/cases/editorial-core-web-vitals">
        <span class="case-seg">portal editorial</span>
        <h3>LCP de 4,8s para 1,9s sem trocar de framework</h3>
        <div class="case-delta"><span>4,8s</span><span aria-hidden="true">&rsaquo;</span><span class="to">1,9s</span></div>
        <p>Três scripts de terceiro respondiam por metade do tempo de bloqueio. A parte difícil não foi técnica, foi convencer o time de mídia.</p>
        <span class="link-more">ler o caso completo</span>
      </a>
    </div>
  </div>
</section>

<!-- 7. GEO/AEO ============================================================= -->
<section class="section" aria-labelledby="h-geo">
  <div class="wrap">
    <div class="geo">
      <div>
        <span class="eyebrow rust">IA, GEO e AEO</span>
        <h2 id="h-geo">O Google parou de ser o único destino do seu conteúdo</h2>
        <p>Parte das suas respostas hoje é lida dentro do ChatGPT, do Perplexity e do bloco de IA da própria busca. O clique não vem, mas a citação vem, e ela é rastreável.</p>
        <p>Aqui isso não é hype de LinkedIn. É teste com amostra, critério declarado e resultado publicado, inclusive quando o resultado é morno.</p>
        <div class="geo-cta">
          <a class="btn btn-rust" href="/ferramentas/aeo-geo-checker">Rodar o AEO/GEO Checker</a>
          <a class="btn btn-ghost" href="/escolinha-seo/geo-aeo">Ver a trilha</a>
        </div>
      </div>
      <ul class="geo-list">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Se o seu conteúdo é citável hoje, e por quais modelos</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Quais entidades o seu domínio já ocupa no Knowledge Graph</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Como medir visibilidade sem depender só do clique</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>O que dos fundamentos continua valendo, que é quase tudo</li>
      </ul>
    </div>
  </div>
</section>

<!-- 8. SOBRE =============================================================== -->
<section class="section" aria-labelledby="h-sobre">
  <div class="wrap">
    <div class="about">
      <figure class="about-photo">
        <img src="/img/autor/perfil-victor-roque-400.webp"
             srcset="/img/autor/perfil-victor-roque-400.webp 400w, /img/autor/perfil-victor-roque-800.webp 800w"
             sizes="160px"
             alt="Victor Roque, consultor de SEO técnico e autor do SEO Maroto"
             width="400" height="400" loading="lazy" decoding="async">
        <figcaption>Victor Roque, 31 anos</figcaption>
      </figure>
      <div>
        <span class="eyebrow">quem escreve</span>
        <h2 id="h-sobre">Um jovem, cansado que deu errado antes de dar certo</h2>
        <p>Prazer eu sou o Victo Roque, mas não jogo no Palmeiras. Nem sei jogar bola. Me dou melhor com o Ciclismo e Judo. Trabalho com SEO técnico e passo boa parte do dia dentro do Vscode e logs, criando sistemas estruturando sitemap e escrevendo relatórios de indexação. Na real nem isso eu tenho feito mas por que o Claude tem feito boa parte do meu trabalho. O SEO Maroto nasceu porque eu cansei de ler conteúdo que promete resultado e não mostra método. E no Brasil os profissionais dessa área tem o Ego do tamanho de uma melancia.</p>
        <p>Eu me sinto endividado, por que mudei a realidade da minha familia fazendo SEO. Gostaria de ajudar de forma honesta quem está começando ou tenha de alguma maneira o interesse nesses assuntos. Aqui eu vou publicar o que testei, com o número que deu, o que não funcionou e o que eu faria diferente. Se algo mudar de opinião com dado novo, o texto é atualizado e a mudança fica registrada.</p>
        <p class="sig">Eu crio, e tomo café.</p>
        <div class="about-cta">
          <a class="btn btn-primary" href="/contato">Agendar um bate-papo de 30 min</a>
          <a class="btn btn-ghost" href="/sobre">Sobre o projeto</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 9. NEWSLETTER ========================================================== -->
<section class="section" aria-labelledby="h-news">
  <div class="wrap">
    <div class="news">
      <span class="eyebrow">newsletter</span>
      <h2 id="h-news">Um e-mail por semana, com coisa que dá para aplicar</h2>
      <p>O experimento da semana, o que mudou na busca e uma correção técnica que você consegue fazer no mesmo dia. Sem "confira nosso último post".</p>
      <form class="news-form" action="/newsletter" method="post">
        <label class="field" for="news-email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4.5" width="20" height="15" rx="2.5"/><path d="M2.5 7l9.5 6.5L21.5 7"/></svg>
          <input id="news-email" type="email" name="email" placeholder="seu@email.com.br" autocomplete="email" required aria-label="Seu e-mail">
        </label>
        <button class="btn btn-primary" type="submit">Assinar</button>
      </form>
      <p class="news-note">Sem spam, sem venda de lista. Cancelar leva um clique.</p>
    </div>
  </div>
</section>

<!-- 10. FAQ ================================================================ -->
{/* O acordeao visivel sai da MESMA lista `faq` que alimenta o FAQPage do
    JSON-LD. No prototipo em HTML eram dois blocos escritos a mao, um visivel
    e um em script, que podiam divergir. O primeiro item nasce aberto: sem
    JavaScript o CSS deixa todas as respostas visiveis. */}
<section class="section" aria-labelledby="h-faq">
  <div class="wrap faq-wrap">
    <div class="section-head section-head-wide">
      <span class="eyebrow">perguntas frequentes</span>
      <h2 id="h-faq">O que costumam me perguntar</h2>
    </div>
    <div class="faq-list" id="faqList">
      {faq.map((item, i) => (
        <div class="faq-item" data-open={i === 0 ? 'true' : 'false'}>
          <h3>
            <button class="faq-q" type="button" id={`faq-q${i + 1}`} aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-a${i + 1}`}>
              {item.question}
              <Icon set="ui" name="caret" strokeWidth={2} />
            </button>
          </h3>
          <div class="faq-a" id={`faq-a${i + 1}`} role="region" aria-labelledby={`faq-q${i + 1}`}>
            <div class="faq-a-inner"><p>{item.answer}</p></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
</main>
</BaseLayout>

<script>
  import { initFaqAccordion } from '../scripts/faq-accordion';
  import { initRoadmapProgress } from '../scripts/roadmap-progress';

  initFaqAccordion();
  initRoadmapProgress();
</script>
