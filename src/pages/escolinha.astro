</BaseLayout>

<script>
  import { initLequePontilhado } from '../scripts/leque-pontilhado';
  import { initFaqAccordion } from '../scripts/faq-accordion';
  initLequePontilhado();
  initFaqAccordion('.faq');
</script>

<style is:global>
.bg-field{
  position: fixed; inset:0; z-index:0; pointer-events:none;
  background:
    radial-gradient(ellipse 900px 500px at 15% -10%, rgba(217,164,65,0.07), transparent 60%),
    radial-gradient(ellipse 700px 500px at 100% 10%, rgba(193,87,58,0.05), transparent 60%);
}
main{ position:relative; z-index:1; flex:1; }
.eyebrow-wrap{ text-align:center; padding:70px 32px 0; }
.eyebrow{ display:inline-flex; align-items:center; gap:8px; font-size:12.5px; color: var(--text-secondary); font-family: var(--mono); border:1px solid var(--border); border-radius:20px; padding:6px 14px 6px 12px; }
.eyebrow::before{ content:''; width:5px; height:5px; border-radius:50%; background: var(--accent); }
.hero{ text-align:center; padding:22px 32px 0; }
h1.hero-title{ font-family: var(--serif); font-weight:400; font-style:italic; font-size: clamp(34px,5.4vw,50px); line-height:1.12; max-width:720px; margin:0 auto 22px; }
h1.hero-title em{ font-style:italic; color: var(--accent); }
.hero-sub{ font-size:14.5px; color: var(--text-secondary); max-width:560px; margin:0 auto 6px; }
.hero-meta{ display:flex; justify-content:center; gap:26px; margin-top:24px; font-family: var(--mono); font-size:12.5px; color: var(--text-muted); }
.hero-meta b{ color: var(--accent); }

.progress-wrap{ max-width:680px; margin:30px auto 0; background: var(--bg-elev); border:1px solid var(--border); border-radius:12px; padding:16px 20px; }
.progress-top{ display:flex; justify-content:space-between; font-size:12.5px; color: var(--text-secondary); margin-bottom:10px; font-family: var(--mono); }
.progress-bar{ height:5px; background: rgba(216,182,138,0.08); border-radius:3px; overflow:hidden; }
.progress-fill{ height:100%; width:0%; background: var(--accent); border-radius:3px; }

.about{ max-width:760px; margin:0 auto; padding:64px 32px 0; }
.about p{ font-size:14.5px; color: var(--text-secondary); line-height:1.75; margin-bottom:16px; }
.about a{ color: var(--accent); text-decoration:underline; text-underline-offset:2px; }
.about a:hover{ color: var(--text-primary); }
.about .tagline{ font-family: var(--serif); font-style:italic; font-size:20px; color: var(--text-primary); margin-top:8px; }

.section-head{ text-align:center; padding:64px 32px 0; margin-bottom:6px; }
.section-head h2{ font-family: var(--serif); font-weight:400; font-style:italic; font-size: clamp(26px,4vw,34px); margin-bottom:10px; }
.section-head p{ color: var(--text-secondary); font-size:14px; max-width:440px; margin:0 auto; }

.canvas{ max-width:1120px; margin:0 auto; padding:34px 20px 60px; position:relative; }
.top-boxes{ display:flex; justify-content:space-between; gap:20px; margin-bottom:36px; }
.info-box{ flex:1; background: var(--bg-elev); border:1px solid var(--border); border-radius:12px; padding:16px 20px; font-size:13px; color: var(--text-secondary); }
.info-box button{ margin-top:10px; background: var(--bg-elev-2); border:1px solid var(--border); padding:7px 14px; border-radius:8px; font-size:12.5px; color: var(--text-primary); font-family: var(--mono); }

.spine-title{ text-align:center; font-family: var(--serif); font-style:italic; font-weight:400; font-size:30px; margin-bottom:30px; }

.flow{ position:relative; }
.spine-line{ position:absolute; left:50%; top:0; bottom:0; width:2px; background: var(--accent); transform: translateX(-50%); z-index:0; opacity:0.45; }

.row{ display:grid; grid-template-columns: 1fr 32px 220px 32px 1fr; align-items:center; gap:0; position:relative; z-index:1; margin-bottom:28px; }
.col-left, .col-right{ display:flex; flex-direction:column; gap:9px; }
.col-left{ align-items:flex-end; }
.col-right{ align-items:flex-start; }
.conn{ background:none; width:100%; }
.conn.none{ background:none; }

.fan{ position:absolute; left:0; top:0; width:100%; height:100%; pointer-events:none; z-index:0; overflow:visible; }
.fan path{ fill:none; stroke: var(--accent); stroke-width:2; stroke-linecap:round; stroke-dasharray:2 5; opacity:0.62; }

.node{ position:relative; z-index:1; display:block; cursor:pointer; border:1px solid var(--border-strong); border-radius:8px; padding:9px 16px; font-size:13.5px; font-weight:500; background: var(--bg-elev); color: var(--text-primary); white-space:nowrap; transition: background .16s ease, border-color .16s ease, color .16s ease; }
.node:hover{ background: var(--bg-elev-2); border-color: rgba(216,182,138,0.34); color: var(--accent); }
.node:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; }
.node.wide{ white-space:normal; text-align:center; max-width:250px; }
.node.accent{ background: var(--accent); color:#2B1704; border-color: var(--accent); font-weight:600; }
.node.rust{ background: rgba(193,87,58,0.14); border-color: var(--rust); color: var(--rust); }
.node.rust:hover{ background: rgba(193,87,58,0.24); border-color: var(--rust); color:#DD7A5C; }

.label{ position:relative; z-index:2; display:block; cursor:pointer; transition: background .16s ease, box-shadow .16s ease, border-color .16s ease; text-align:center; font-size:14px; font-weight:600; line-height:1.35; padding:11px 18px; border-radius:8px; font-family: var(--sans); }
.label.plain{ background:none; border:none; color: var(--text-primary); }
.label.boxed{ background: var(--accent); color:#2B1704; border:1px solid var(--accent); box-shadow: 0 4px 18px rgba(217,164,65,0.18); }
.label.boxed:hover{ background:#E6B75E; border-color:#E6B75E; box-shadow: 0 6px 26px rgba(217,164,65,0.34); }
.label:focus-visible{ outline:2px solid var(--text-primary); outline-offset:3px; }

.cluster{ position:relative; z-index:2; background: var(--bg-elev); border:1px solid var(--border); border-radius:12px; padding:14px; width:100%; }
.cluster-title{ font-size:11.5px; font-weight:700; text-align:center; margin-bottom:12px; color: var(--rust); text-transform:uppercase; letter-spacing:0.06em; font-family: var(--mono); }
.cluster-grid{ display:grid; grid-template-columns:1fr 1fr; gap:9px; }
.cluster .node{ text-align:center; white-space:normal; }

.cluster-list{ display:flex; flex-direction:column; gap:9px; }
.full-row{ display:grid; grid-template-columns:1fr; gap:22px; position:relative; z-index:1; margin-bottom:28px; }
.triple-cluster{ display:flex; gap:18px; }
.triple-cluster .cluster{ flex:1; }

.keep-learning{ position:relative; z-index:2; background: var(--bg-elev); border:1px solid var(--border); border-radius:14px; padding:22px 28px; text-align:center; margin: 34px auto 0; max-width:520px; }
.keep-learning p{ font-size:13.5px; color: var(--text-secondary); margin-bottom:14px; }
.keep-learning .links{ display:flex; justify-content:center; gap:10px; }
.keep-learning a{ background: rgba(193,87,58,0.15); border:1px solid var(--rust); color: var(--rust); padding:8px 18px; border-radius:8px; font-size:13px; font-weight:500; }

.dotted-down{ width:2px; height:36px; background: var(--accent); margin:0 auto; opacity:0.45; }

/* FAQ ==================================================================== */
.faq{ max-width:900px; margin:0 auto; padding:86px 28px 34px; }
.faq h2{ font-family: var(--serif); font-style:italic; font-weight:400; font-size: clamp(28px,4vw,36px); text-align:center; margin-bottom:44px; }
.faq-list{ border-top:1px solid var(--border); }
.faq-item{ border-bottom:1px solid var(--border); }
.faq-q{ width:100%; display:flex; align-items:center; justify-content:space-between; gap:20px; background:none; border:none; cursor:pointer; text-align:left; padding:20px 2px; font-family: var(--sans); font-size:15px; font-weight:600; line-height:1.45; color: var(--text-primary); transition: color .15s ease; }
.faq-q:hover{ color: var(--accent); }
.faq-q:focus-visible{ outline:2px solid var(--accent); outline-offset:3px; border-radius:6px; }
.faq-q svg{ width:18px; height:18px; flex-shrink:0; color: var(--text-muted); transition: transform .28s ease, color .15s ease; }
.faq-item[data-open="true"] .faq-q svg{ transform: rotate(180deg); color: var(--accent); }
.faq-a-inner{ min-height:0; overflow:hidden; }
.faq-a-inner p{ font-size:14.5px; line-height:1.75; color: var(--text-secondary); padding:0 40px 22px 2px; margin:0; }
.faq-a-inner p + p{ padding-top:14px; }
.faq.js .faq-a{ display:grid; grid-template-rows:0fr; transition: grid-template-rows .3s ease; }
.faq.js .faq-item[data-open="true"] .faq-a{ grid-template-rows:1fr; }


@media (max-width:560px){
  .faq{ padding:64px 20px 0; }
  .faq-q{ font-size:14.5px; padding:18px 2px; }
  .faq-a-inner p{ padding-right:8px; }
}

.community{ text-align:center; padding:80px 20px; }
.community h2{ font-family: var(--serif); font-style:italic; font-weight:400; font-size:34px; margin-bottom:12px; }
.community p{ color: var(--text-secondary); font-size:14.5px; margin-bottom:40px; }
.stats{ display:flex; justify-content:center; align-items:flex-start; gap:32px 42px; flex-wrap:wrap; }
.stat .num{ font-family: var(--serif); font-style:italic; font-size:42px; line-height:1.1; color: var(--accent); }
.stat .lbl{ font-size:13px; color: var(--text-secondary); margin-bottom:14px; font-family: var(--mono); }
.stat .cta{ display:inline-block; background: var(--bg-elev); border:1px solid var(--border); border-radius:8px; padding:8px 16px; font-size:12.5px; color: var(--text-primary); transition: color .15s ease, border-color .15s ease, background .15s ease; }
.stat .cta:hover{ color: var(--accent); border-color: var(--border-strong); background: var(--bg-elev-2); }
.stat .cta:focus-visible{ outline:2px solid var(--accent); outline-offset:3px; }

@media (max-width:880px){
  .row{ grid-template-columns:1fr; gap:10px; }
  .conn{ display:none; }
  .col-left, .col-right{ align-items:stretch; }
  .node.wide{ max-width:none; }
  .spine-line{ display:none; }
  .fan{ display:none; }
  .triple-cluster{ flex-direction:column; }
  .stats{ gap:30px; }
}
</style>
