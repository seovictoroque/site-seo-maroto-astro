            <a class="node" href="#">Estrutura de categorias</a>
          </div>
        </div>
        <div class="cluster">
          <div class="cluster-title">Headless & Custom</div>
          <div class="cluster-list">
            <a class="node" href="#">Rendering (SSR/SSG)</a>
            <a class="node" href="#">SEO em Next.js / React</a>
          </div>
        </div>
      </div>
    </div>

    <div class="full-row">
      <a class="label boxed" href="#" style="margin:0 auto 16px;">4. Aprofunde seus conhecimentos de SEO</a>
      <div class="triple-cluster">
        <div class="cluster">
          <div class="cluster-title">Technical SEO avançado</div>
          <div class="cluster-list">
            <a class="node" href="#">Dados estruturados (Schema)</a>
            <a class="node" href="#">Core Web Vitals</a>
            <a class="node" href="#">Crawl budget</a>
            <a class="node" href="#">Log file analysis</a>
          </div>
        </div>
        <div class="cluster">
          <div class="cluster-title">Otimização de conteúdo avançada</div>
          <div class="cluster-list">
            <a class="node" href="#">Topic clusters e pillar pages</a>
            <a class="node" href="#">E-E-A-T</a>
            <a class="node" href="#">Content gap analysis</a>
            <a class="node" href="#">Atualização de conteúdo</a>
          </div>
        </div>
        <div class="cluster">
          <div class="cluster-title">Construção de links avançada</div>
          <div class="cluster-list">
            <a class="node" href="#">Digital PR</a>
            <a class="node" href="#">Link building white-hat</a>
            <a class="node" href="#">Análise de perfil de backlinks</a>
            <a class="node" href="#">Linkagem interna estratégica</a>
          </div>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-left">
        <a class="node wide" href="#">Enterprise SEO</a>
        <a class="node wide" href="#">Programmatic SEO</a>
      </div>
      <div class="conn"></div>
      <a class="label boxed" href="#">5. Especialista em SEO</a>
      <div class="conn"></div>
      <div class="col-right">
        <a class="node wide" href="#">Relatórios executivos</a>
        <a class="node wide" href="#">Gestão de squads de SEO</a>
        <a class="node wide" href="#">SEO internacional (hreflang)</a>
        <a class="node wide" href="#">JavaScript SEO</a>
      </div>
    </div>

    <div class="row">
      <div class="col-left"></div>
