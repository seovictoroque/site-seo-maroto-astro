---
/**
 * CONTATO.
 *
 * Pagina unica de conversao do site. Hero de duas colunas com o card de quem
 * responde, o que esperar dos 30 minutos, caixa de sim e nao, agendador,
 * formulario alternativo e FAQ.
 *
 * ORIGEM: e o conteudo integral da antiga /solucoes/agendar. A arvore
 * /solucoes inteira (hub, agendar e treinamento) foi removida e esta pagina
 * absorveu o conteudo dela. O site ainda nao tinha sido publicado, entao nao
 * existe redirect: as URLs antigas simplesmente deixaram de existir e todo
 * link interno para elas foi trocado por /contato.
 *
 * A cena do notebook em HTML e CSS que existia aqui antes saiu junto com o
 * hero antigo, e o styles/pages/contato.css que so a desenhava foi removido.
 * O historico do Git guarda as duas coisas se um dia precisar.
 *
 * ATENCAO: o agendador e uma COMPOSICAO PROPRIA em HTML e CSS, com dados
 * estaticos de setembro de 2026. Ele nao marca nada: o agendador.ts so faz a
 * selecao visual do dia e do horario. O embed nativo do Google Agenda foi
 * rejeitado porque renderiza em tema claro e quebra a identidade. O
 * formulario tambem nao envia: o submit e barrado pelo form-sem-endpoint.ts
 * ate existir endpoint.
 *
 * O breadcrumb sai da MESMA lista `crumbs` que a pagina renderiza, e o
 * FAQPage da MESMA lista `faq`. O CSS compartilhado esta em page-kit.css e o
 * das paginas de conversao em styles/pages/conversao.css.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import FaqSection from '../components/page/FaqSection.astro';
import type { FaqItem } from '../lib/faq';
import { abs, breadcrumbNode, faqNode, personId } from '../lib/schema';
import { site } from '../data/site';

import '../styles/page-kit.css';
import '../styles/pages/conversao.css';

const crumbs = [{ href: '/', label: 'Home' }, { label: 'Contato' }];

const faq: FaqItem[] = [
  {
    question: 'É venda disfarçada?',
    answer:
      'Não. A conversa tem valor sozinha: você sai com um diagnóstico inicial e um próximo passo, contratando ou não. Se eu achar que não sou a pessoa certa, digo na hora e indico quem é.',
  },
  {
    question: 'Preciso preparar alguma coisa?',
    answer:
      'Ajuda muito ter acesso ao Search Console aberto e saber qual página ou template representa o dinheiro do negócio. Se não tiver, a gente conversa mesmo assim.',
  },
  {
    question: 'Quem participa da chamada?',
    answer:
      'Você e eu. Se fizer sentido chamar alguém de desenvolvimento ou de conteúdo, chame: costuma render mais quando quem implementa está na sala.',
  },
  {
    question: 'E se 30 minutos não derem conta?',
    answer:
      'Não dão em quase nenhum caso, e tudo bem. O objetivo é sair com clareza sobre o primeiro passo, não com o plano inteiro pronto.',
  },
  {
    question: 'Posso remarcar?',
    answer:
      'Pode, pelo link de confirmação que chega no e-mail. Só peço aviso com alguma antecedência, porque o horário costuma ter fila.',
  },
];
---

<BaseLayout
  title="Contato: agende um bate-papo de 30 minutos sobre SEO | SEO Maroto"
  description="30 minutos gratuitos para olhar o seu site junto e definir o próximo passo de SEO. Sem pitch e sem apresentação institucional."
  path="/contato"
  schema={[
    {
      '@type': 'ContactPage',
      '@id': `${abs('/contato')}#page`,
      url: abs('/contato'),
      name: 'Contato',
      inLanguage: site.lang,
      isPartOf: { '@id': `${site.url}/#website` },
      mainEntity: { '@id': `${site.url}/#org` },
    },
    {
      '@type': 'Service',
      '@id': `${abs('/contato')}#service`,
      name: 'Bate-papo de diagnóstico de SEO',
      serviceType: 'Consultoria de SEO',
      url: abs('/contato'),
      areaServed: 'BR',
      provider: { '@id': personId('victor-roque') },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
    },
    faqNode('/contato', faq),
    breadcrumbNode(crumbs),
  ]}
>
<div class="bg-field"></div>
<main id="conteudo">
<Breadcrumb items={crumbs} />

<section class="hero-split">
  <div class="hs-left">
    <span class="eyebrow">30 minutos, gratuito, sem pitch</span>
    <h1 class="hero-title">Meia hora para descobrir <em>por onde começar</em></h1>
    <p class="hero-sub">Você mostra o problema, eu digo o que faria no seu lugar. Sem apresentação institucional, sem slide de cases e sem proposta empurrada no final.</p>
    <div class="hero-meta"><span><b>30 min</b> de call</span><span><b>R$ 0</b> de custo</span><span><b>1</b> próximo passo definido</span></div>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#agenda">Escolher um horário</a>
      <a class="btn btn-ghost" href="#formulario">Prefiro escrever</a>
    </div>
  </div>
  <div class="hs-right">
    <h2 class="meet-h">Quem responde</h2>
    <p class="meet-sub">Quem entra na chamada com você.</p>
    <div class="about-card">
      <img class="about-photo" src="/img/autor/perfil-victor-roque-400.webp"
           srcset="/img/autor/perfil-victor-roque-400.webp 400w, /img/autor/perfil-victor-roque-800.webp 800w"
           sizes="120px" width="400" height="400"
           alt="Victor Roque, especialista em SEO" loading="lazy" decoding="async">
      <h3>Victor Roque</h3>
      <p class="about-role">SEO há cerca de dez anos, de ecommerce in-house a cliente enterprise. Itapetininga, São Paulo.</p>
      <p class="about-text">Toda mensagem que chega aqui é lida e respondida por mim. Se a resposta for "não sou a pessoa certa para isso", eu digo e indico quem é, o que costuma valer mais do que uma proposta genérica.</p>
      <p class="about-text">Quem entra na chamada sou eu, do começo ao fim. Sem pré-atendimento, sem qualificação por questionário e sem passar o seu caso para outra pessoa.</p>
      <div class="about-actions">
        <a class="btn btn-ghost" href="/sobre">Minha história</a>
        <a class="btn btn-ghost" href="/comunidade">Comunidade</a>
      </div>
    </div>
  </div>
</section>

<div class="section-head">
  <h2>O que acontece nos 30 minutos</h2>
</div>

<div class="steps">
  <div class="step">
    <div class="step-num">01</div>
    <div class="step-body"><h3>Cinco minutos de contexto</h3><p>Que negócio é, de onde vem a receita hoje e o que fez você procurar SEO agora.</p></div>
  </div>
  <div class="step">
    <div class="step-num">02</div>
    <div class="step-body"><h3>Quinze minutos olhando junto</h3><p>Abrimos o site e o Search Console e eu falo em voz alta o que estou vendo, inclusive as partes chatas.</p></div>
  </div>
  <div class="step">
    <div class="step-num">03</div>
    <div class="step-body"><h3>Dez minutos de próximo passo</h3><p>Saio da chamada com uma recomendação priorizada. Você decide se faz internamente, com outra pessoa ou comigo.</p></div>
  </div>
</div>

<div class="section-head">
  <h2>Para quem essa conversa serve</h2>
</div>

<div class="split">
  <div class="box yes"><h3>Faz sentido se</h3><ul><li>Seu site já tem tráfego e você não sabe por que ele parou de crescer.</li><li>Você tem uma auditoria na gaveta e ninguém implementou nada dela.</li><li>O time de desenvolvimento pergunta "por que isso é prioridade" e você quer uma resposta melhor.</li><li>Você quer aparecer em resposta de IA e não sabe se é hype ou se já dá para trabalhar.</li></ul></div>
  <div class="box no"><h3>Não faz sentido se</h3><ul><li>Você quer garantia de primeira posição em prazo fechado. Não existe.</li><li>O site vai ser refeito do zero em dois meses. Fale comigo depois, ou antes de decidir a stack.</li><li>Você procura pacote de compra de links.</li><li>Você quer uma segunda opinião só para usar como argumento em briga interna.</li></ul></div>
</div>

<section class="duo" id="agenda">

  <div class="duo-left">
    <h2 class="meet-h">Escolha um horário</h2>
    <p class="meet-sub">Fuso de Brasília. A confirmação chega por e-mail com o link da chamada.</p>
    <!-- COMPONENTE DE AGENDAMENTO
         Marcacao propria, no tema do site, com o mesmo fluxo do Calendly.
         Os dados sao estaticos, e o JS so troca a selecao visual.
         Para plugar o Calendly depois, apague a div.booker inteira e use
         <div class="calendly-inline-widget" data-url="https://calendly.com/SEU-USUARIO/30min"
              style="min-width:320px;height:700px"></div>
         mais o script de https://assets.calendly.com/assets/external/widget.js -->
    <div class="booker uteis">
      <div class="bk-strip">
        <span class="bk-ev">Bate-papo de 30 minutos</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>30 min</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="6" width="13" height="12" rx="2.5"/><path d="M15.5 10.5 21.5 7v10l-6-3.5z"/></svg>Vídeo</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.6 5.6 6.4.8-4.7 4.3 1.2 6.3L12 17l-5.5 3 1.2-6.3L3 9.4l6.4-.8z"/></svg>Gratuito</span>
      </div>

      <div class="bk-cal">
        <div class="bk-head">
          <h3>Escolha a data</h3>
          <div class="bk-nav">
            <button type="button" aria-label="Mês anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>
            <span class="bk-month">Setembro 2026</span>
            <button type="button" aria-label="Próximo mês"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
          </div>
        </div>
        <div class="bk-week"><span>seg</span><span>ter</span><span>qua</span><span>qui</span><span>sex</span></div>
        <div class="bk-grid">
          <span class="bk-day empty" aria-hidden="true"></span>
          <span class="bk-day off">1</span>
          <span class="bk-day off">2</span>
          <span class="bk-day off">3</span>
          <span class="bk-day off">4</span>
          <button type="button" class="bk-day free" data-dia="7" aria-pressed="false">7</button>
          <button type="button" class="bk-day free" data-dia="8" aria-pressed="false">8</button>
          <button type="button" class="bk-day free" data-dia="9" aria-pressed="false">9</button>
          <button type="button" class="bk-day free" data-dia="10" aria-pressed="false">10</button>
          <button type="button" class="bk-day free" data-dia="11" aria-pressed="false">11</button>
          <button type="button" class="bk-day free" data-dia="14" aria-pressed="false">14</button>
          <button type="button" class="bk-day free is-sel" data-dia="15" aria-pressed="true">15</button>
          <button type="button" class="bk-day free" data-dia="16" aria-pressed="false">16</button>
          <button type="button" class="bk-day free" data-dia="17" aria-pressed="false">17</button>
          <button type="button" class="bk-day free" data-dia="18" aria-pressed="false">18</button>
          <button type="button" class="bk-day free" data-dia="21" aria-pressed="false">21</button>
          <button type="button" class="bk-day free" data-dia="22" aria-pressed="false">22</button>
          <button type="button" class="bk-day free" data-dia="23" aria-pressed="false">23</button>
          <button type="button" class="bk-day free" data-dia="24" aria-pressed="false">24</button>
          <button type="button" class="bk-day free" data-dia="25" aria-pressed="false">25</button>
          <button type="button" class="bk-day free" data-dia="28" aria-pressed="false">28</button>
          <button type="button" class="bk-day free" data-dia="29" aria-pressed="false">29</button>
          <button type="button" class="bk-day free" data-dia="30" aria-pressed="false">30</button>
          <span class="bk-day empty" aria-hidden="true"></span>
          <span class="bk-day empty" aria-hidden="true"></span>
        </div>
        <p class="bk-tz">Fuso de Brasília, UTC-3. Atendimento de segunda a sexta, dias em destaque têm horário livre.</p>
      </div>

      <div class="bk-slots">
        <p class="bk-day-label" id="bkDia">Terça, 15 de setembro</p>
        <div class="bk-slot-list">
          <button type="button" class="bk-slot" aria-pressed="false">09:00</button>
          <button type="button" class="bk-slot" aria-pressed="false">09:30</button>
          <button type="button" class="bk-slot is-sel" aria-pressed="true">10:00</button>
          <button type="button" class="bk-slot" aria-pressed="false">11:00</button>
          <button type="button" class="bk-slot" aria-pressed="false">11:30</button>
          <button type="button" class="bk-slot" aria-pressed="false">14:00</button>
          <button type="button" class="bk-slot" aria-pressed="false">14:30</button>
          <button type="button" class="bk-slot" aria-pressed="false">15:00</button>
          <button type="button" class="bk-slot" aria-pressed="false">16:00</button>
          <button type="button" class="bk-slot" aria-pressed="false">17:00</button>
        </div>
        <button class="btn btn-primary bk-confirm" type="button">Confirmar horário</button>
        <p class="bk-note">A confirmação chega por e-mail com o link da chamada.</p>
      </div>

    </div>
  </div>

  <aside class="duo-right" id="formulario">
    <h2 class="meet-h">Ou peça um horário</h2>
    <p class="meet-sub">Se nenhum horário servir, escreve aqui que eu proponho duas ou três opções.</p>
    <div class="write-card">
      <form id="formAgendar">
        <div class="field"><label for="ag-nome">Nome</label><input id="ag-nome" type="text" autocomplete="name"></div>
        <div class="field"><label for="ag-email">E-mail</label><input id="ag-email" type="email" autocomplete="email"></div>
        <div class="field"><label for="ag-site">Site</label><input id="ag-site" type="url" placeholder="https://"></div>
        <div class="field grow"><label for="ag-ctx">O que está travando hoje</label><textarea id="ag-ctx" placeholder="Duas ou três linhas já bastam."></textarea></div>
        <button class="btn btn-primary" type="submit">Pedir um horário</button>
        <p class="hint">Ao enviar você concorda com a <a href="/politica-de-privacidade">política de privacidade</a>. Seu e-mail não entra em lista de disparo sem você pedir.</p>
      </form>
    </div>
  </aside>

</section>


<FaqSection items={faq} />
</main>
</BaseLayout>

<script>
  import { initFaqAccordion } from '../scripts/faq-accordion';
  initFaqAccordion('.faq');
  import { initAgendador } from '../scripts/agendador';
  import { initFormSemEndpoint } from '../scripts/form-sem-endpoint';
  initAgendador();
  initFormSemEndpoint('#formAgendar');
</script>
