---
/**
 * O ANTES E O DEPOIS, em bloco.
 *
 * Usado em dois tamanhos: `size="hero"` no topo do case e `size="card"`
 * dentro do CaseCard. O mesmo componente nos dois lugares porque o numero
 * precisa ser lido igual na listagem e na pagina, e porque ele sai do MESMO
 * campo `metric` do frontmatter que alimenta o JSON-LD.
 *
 * O rotulo vem ANTES dos numeros de proposito. "12% para 71%" sozinho nao
 * significa nada fora da pagina, e e exatamente esse recorte que a IA cita.
 */
interface Props {
  label: string;
  before: string;
  after: string;
  note?: string;
  size?: 'hero' | 'card';
}

const { label, before, after, note, size = 'card' } = Astro.props;
---

<div class:list={['cs-metric', size === 'hero' && 'hero']}>
  <p class="csm-label">{label}</p>
  <p class="csm-values">
    <span class="csm-before">{before}</span>
    <svg class="csm-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    <span class="csm-after">{after}</span>
  </p>
  {note && <p class="csm-note">{note}</p>}
</div>

<style is:global>
.cs-metric{ display:flex; flex-direction:column; gap:7px; }
.csm-label{ font-family: var(--mono); font-size:11px; text-transform:uppercase; letter-spacing:0.09em; color: var(--text-muted); }
.csm-values{ display:flex; align-items:baseline; gap:12px; flex-wrap:wrap; }
.csm-before{ font-family: var(--serif); font-style:italic; font-size:26px; line-height:1; color: var(--text-muted); }
.csm-arrow{ width:17px; height:17px; flex-shrink:0; color: var(--text-muted); align-self:center; }
.csm-after{ font-family: var(--serif); font-style:italic; font-size:34px; line-height:1; color: var(--accent-ink); }
.csm-note{ font-family: var(--mono); font-size:11.5px; color: var(--text-muted); line-height:1.55; }

.cs-metric.hero .csm-before{ font-size:38px; }
.cs-metric.hero .csm-arrow{ width:24px; height:24px; }
.cs-metric.hero .csm-after{ font-size: clamp(46px,6vw,62px); }
.cs-metric.hero .csm-note{ font-size:12.5px; }

@media (max-width:620px){
  .cs-metric.hero .csm-before{ font-size:30px; }
  .cs-metric.hero .csm-after{ font-size:42px; }
}
</style>
