---
/**
 * RODAPE DO SITE.
 *
 * Coluna de marca com logo, descricao e redes, mais quatro colunas de links
 * e a barra inferior de creditos. Nao usa JavaScript.
 *
 * Para o rodape nunca subir em pagina curta, o layout raiz aplica
 * `body{ display:flex; flex-direction:column }` e `main{ flex:1 }`, e aqui o
 * `margin-top:auto` fecha a conta.
 *
 * O <style> e is:global porque os icones sociais vem de Icon.astro via
 * set:html e nao receberiam o atributo de escopo do Astro.
 */
import Icon from './Icon.astro';
import { footerColumns, legalLinks, socialLinks } from '../../data/navigation';
import { site } from '../../data/site';
---

<footer class="site-footer">
  <div class="footer-inner">

    <div class="footer-brand">
      <a class="fb-logo" href="/" aria-label={`${site.name}, ir para a home`}>
        <img src={site.icon} alt={site.name} width="60" height="60" />
      </a>
      <p>Roteiro gratuito e de código aberto para aprender SEO do zero ao avançado, do técnico ao GEO/AEO.</p>
      <div class="footer-social">
        {socialLinks.map((s) => (
          <a href={s.href} aria-label={s.label} title={s.label}>
            <Icon set="social" name={s.icon} />
          </a>
        ))}
      </div>
    </div>

    {footerColumns.map((col) => (
      <div class="footer-col">
        <h3>{col.title}</h3>
        <ul>
          {col.links.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}

  </div>

  <div class="footer-bottom">
    {/* TODO: os dois href="#" abaixo vieram assim do HTML de origem. */}
    <span class="fb-credit">
      <a href="/">SEO Maroto</a>, ideado por <a href="#">Victor Roque</a>, e desenvolvido com carinho ♥ <a href="#">E42 Consultoria</a>.
    </span>
    <div class="footer-legal">
      {legalLinks.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </div>
  </div>
</footer>

<style is:global>
/* CSS DO FOOTER, extraido de menu-footer.html sem alterar valor nenhum. */
footer.site-footer{ border-top:1px solid var(--border); background: var(--bg); margin-top:auto; }
.footer-inner{ max-width:1220px; margin:0 auto; padding:58px 28px 0; display:grid; grid-template-columns:1.5fr 1fr 1fr 1fr 1fr; gap:40px; }
.footer-brand .fb-logo{ display:inline-flex; align-items:center; gap:11px; margin-bottom:16px; }
.footer-brand .fb-logo img{ width:60px; height:60px; border-radius:14px; object-fit:cover; display:block; }
.footer-brand p{ font-size:13.5px; line-height:1.75; color: var(--text-secondary); max-width:290px; }
.footer-social{ display:flex; gap:4px; margin-top:20px; margin-left:-8px; }
.footer-social a{ width:34px; height:34px; display:flex; align-items:center; justify-content:center; border-radius:9px; color: var(--text-muted); transition: color .15s ease, background .15s ease; }
.footer-social a svg{ width:19px; height:19px; display:block; }
.footer-social a:hover{ color: var(--accent); background: rgba(216,182,138,0.07); }
.footer-col h3{ font-family: var(--mono); font-size:11px; font-weight:500; text-transform:uppercase; letter-spacing:0.11em; color: var(--text-muted); margin-bottom:18px; }
.footer-col ul{ list-style:none; display:flex; flex-direction:column; gap:13px; }
.footer-col a{ font-size:13.5px; color: var(--text-secondary); transition: color .15s ease; }
.footer-col a:hover{ color: var(--accent); }
.fb-credit a{ color: var(--text-secondary); border-bottom:1px solid var(--border-strong); padding-bottom:1px; }
.fb-credit a:hover{ color: var(--accent); border-color: var(--accent); }
.footer-bottom{ max-width:1220px; margin:44px auto 0; padding:22px 28px 30px; border-top:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; gap:14px 26px; flex-wrap:wrap; font-family: var(--mono); font-size:12px; color: var(--text-muted); }
.footer-legal{ display:flex; gap:22px; flex-wrap:wrap; }
.footer-bottom a{ color: var(--text-muted); transition: color .15s ease; }
.footer-bottom a:hover{ color: var(--accent); }
@media (max-width:1040px){
  .footer-inner{ grid-template-columns:repeat(4, 1fr); gap:34px 26px; padding-top:48px; }
  .footer-brand{ grid-column:1 / -1; }
  .footer-brand p{ max-width:none; }
}
@media (max-width:720px){ .footer-inner{ grid-template-columns:1fr 1fr; gap:34px 26px; } }
@media (max-width:520px){
  .footer-inner{ grid-template-columns:1fr; gap:30px; padding:40px 20px 0; }
  .footer-bottom{ flex-direction:column; align-items:flex-start; gap:14px; padding:20px 20px 28px; }
  .footer-legal{ flex-direction:column; gap:11px; }
}
/* Estes tres links tinham style="text-decoration: underline" inline no HTML
   de origem. Virou regra de CSS. */
.footer-legal a{ text-decoration:underline; }
</style>
