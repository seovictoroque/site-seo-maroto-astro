---
/**
 * HEADER DO SITE, componente unico.
 *
 * Substitui menu-header.html e menu-header-blog.html. O CSS dos dois era
 * byte a byte identico e o HTML diferia em tres pontos: qual link estava
 * ativo, um bloco de categorias sob "Blog" no painel mobile e a faixa de
 * sub-menu depois do header. Os dois primeiros viraram a prop `variant`, o
 * terceiro virou o componente BlogSubnav, que o BlogLayout monta em seguida.
 *
 * ESTADO ATIVO
 * Sai de Astro.url.pathname. Nenhuma pagina precisa dizer onde esta.
 *
 * ARMADILHA RESOLVIDA AQUI
 * O CSS original estilizava a tag `nav` no seletor de elemento, entao todo
 * nav novo da pagina (sub-menu, breadcrumb, indice) nascia com barra preta
 * sticky no topo, e cada um precisava de um bloco de resets na marra. Agora
 * o seletor e `.site-nav`, que era a correcao definitiva ja prevista. Por
 * isso os resets defensivos sairam do sub-menu, do breadcrumb e do indice.
 *
 * O <style> e is:global de proposito: os SVGs vem de Icon.astro via set:html
 * e nao recebem o atributo de escopo do Astro, entao regras como
 * `.nav-links > a > svg` nao alcancariam o icone se o bloco fosse escopado.
 */
import Icon from './Icon.astro';
import { navItems, socialLinks } from '../../data/navigation';
import { categories } from '../../data/categories';
import { site } from '../../data/site';

interface Props {
  /** 'blog' acrescenta a lista de categorias sob Blog no painel mobile */
  variant?: 'site' | 'blog';
}

const { variant = 'site' } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

/** Ativo quando a rota e a propria ou uma filha dela. */
function isActive(href: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}

/** Em item com dropdown, o ativo considera tambem os filhos. */
function branchIsActive(item: (typeof navItems)[number]): boolean {
  return isActive(item.href) || (item.children ?? []).some((c) => isActive(c.href));
}
---

<nav class="site-nav" aria-label="Navegação principal">
  <div class="nav-left">
    <div class="brand">
      <a href="/" aria-label={`${site.name}, ir para a home`}>
        <img src={site.icon} alt={site.name} width="40" height="40" />
      </a>
    </div>

    <div class="nav-links">
      {navItems.map((item) =>
        item.children ? (
          <div class="dropdown">
            <a
              href={item.href}
              aria-haspopup="true"
              class={branchIsActive(item) ? 'active' : undefined}
              aria-current={branchIsActive(item) ? 'page' : undefined}
            >
              <Icon name={item.icon} />
              {item.label}
              <Icon set="ui" name="caret" strokeWidth={2.2} class="caret" />
            </a>
            <div class:list={['dropdown-menu', item.mega && 'mega']}>
              {item.children.map((child) => (
                <a href={child.href}>
                  {child.label}
                  {child.hint && <span>{child.hint}</span>}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class={isActive(item.href) ? 'active' : undefined}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <Icon name={item.icon} />
            {item.label}
          </a>
        )
      )}
    </div>
  </div>

  <div class="nav-right">
    {socialLinks.map((s) => (
      <a class="icon-btn" href={s.href} aria-label={s.label} title={s.label}>
        <Icon set="social" name={s.icon} />
      </a>
    ))}
    <button
      class="nav-toggle"
      type="button"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <Icon set="ui" name="burger" strokeWidth={2} />
    </button>
  </div>
</nav>

<div class="mobile-menu" id="mobileMenu">
  {navItems.map((item) => (
    <>
      <a
        class="m-link"
        href={item.href}
        aria-current={isActive(item.href) ? 'page' : undefined}
      >
        <Icon name={item.icon} />
        {item.label}
      </a>
      {item.children && (
        <div class="m-sub">
          {item.children.map((child) => (
            <a href={child.href}>{child.label}</a>
          ))}
        </div>
      )}
      {/* nas paginas de blog, as categorias entram sob o item Blog */}
      {variant === 'blog' && item.href === '/blog' && (
        <div class="m-sub">
          {categories.map((c) => (
            <a href={`/blog/categoria/${c.slug}`}>{c.shortName}</a>
          ))}
        </div>
      )}
    </>
  ))}

  <div class="mobile-social">
    {socialLinks.map((s) => (
      <a class="icon-btn" href={s.href} aria-label={s.label}>
        <Icon set="social" name={s.icon} />
      </a>
    ))}
  </div>
</div>

<script>
  import { initMobileMenu } from '../../scripts/mobile-menu';
  initMobileMenu();
</script>

<style is:global>
/* CSS DO HEADER, extraido de menu-header.html sem alterar valor nenhum.
   Unica mudanca: o seletor `nav` virou `.site-nav`. */
.site-nav{ display:flex; align-items:center; justify-content:space-between; padding:14px 28px; font-size:14px; border-bottom:1px solid var(--border); position:sticky; top:0; background:rgba(13,9,4,0.88); backdrop-filter: blur(10px); z-index:50; }
.nav-left{ display:flex; align-items:center; gap:24px; }
.brand{ display:flex; align-items:center; gap:10px; font-family: var(--serif); font-style:italic; font-size:19px; }
.brand img{ width:40px; height:40px; border-radius:10px; object-fit:cover; display:block; }

.nav-links{ display:flex; align-items:center; gap:2px; }
.nav-links > a, .dropdown > a{ position:relative; display:inline-flex; align-items:center; gap:7px; color: var(--text-secondary); font-size:13.5px; padding:7px 9px; border-radius:8px; transition: color .15s ease, background .15s ease; }
.nav-links > a > svg, .dropdown > a > svg{ width:16px; height:16px; flex-shrink:0; opacity:.7; }
.nav-links > a > svg.caret, .dropdown > a > svg.caret{ width:12px; height:12px; margin-left:-2px; opacity:.45; }
.nav-links > a:hover, .dropdown:hover > a, .dropdown:focus-within > a{ color: var(--text-primary); background: rgba(216,182,138,0.06); }
.nav-links > a:hover > svg, .dropdown:hover > a > svg{ opacity:1; color: var(--accent); }
.nav-links a.active{ color: var(--text-primary); }
.nav-links a.active > svg{ opacity:1; color: var(--accent); }
.nav-links a.active::after{ content:''; position:absolute; left:9px; right:9px; bottom:-14px; height:2px; background: var(--accent); border-radius:2px; }

.dropdown{ position:relative; }
.dropdown-menu{ position:absolute; top:calc(100% + 12px); left:0; min-width:250px; background: var(--bg-elev); border:1px solid var(--border-strong); border-radius:12px; padding:7px; opacity:0; visibility:hidden; transform: translateY(-6px); transition: opacity .16s ease, transform .16s ease, visibility .16s; box-shadow: 0 18px 44px rgba(0,0,0,0.55); }
.dropdown-menu::before{ content:''; position:absolute; top:-14px; left:0; right:0; height:14px; }
.dropdown:hover .dropdown-menu, .dropdown:focus-within .dropdown-menu{ opacity:1; visibility:visible; transform: translateY(0); }
.dropdown-menu.mega{ width:600px; display:grid; grid-template-columns:1fr 1fr; gap:1px 6px; }
.dropdown-menu a{ display:flex; flex-direction:column; gap:3px; padding:9px 11px; border-radius:8px; color: var(--text-primary); font-size:13px; }
.dropdown-menu a span{ font-size:11px; color: var(--text-muted); font-family: var(--mono); }
.dropdown-menu a:hover{ background: var(--bg-elev-2); }
.dropdown-menu a:hover span{ color: var(--text-secondary); }

.nav-right{ display:flex; align-items:center; gap:4px; }
.icon-btn{ width:34px; height:34px; display:flex; align-items:center; justify-content:center; border-radius:9px; color: var(--text-muted); transition: color .15s ease, background .15s ease; }
.icon-btn svg{ width:19px; height:19px; display:block; }
.icon-btn:hover{ color: var(--accent); background: rgba(216,182,138,0.07); }

.nav-toggle{ display:none; width:38px; height:38px; align-items:center; justify-content:center; border:1px solid var(--border); border-radius:9px; background:none; color: var(--text-primary); cursor:pointer; margin-left:6px; }
.nav-toggle svg{ width:19px; height:19px; display:block; }
.mobile-menu{ display:none; position:fixed; left:0; right:0; top:69px; bottom:0; background: var(--bg); border-top:1px solid var(--border); padding:14px 22px 40px; overflow-y:auto; z-index:49; }
.mobile-menu.open{ display:block; }
.mobile-menu .m-link{ display:flex; align-items:center; gap:13px; padding:14px 6px; font-size:15px; color: var(--text-primary); border-bottom:1px solid var(--border); }
.mobile-menu .m-link svg{ width:18px; height:18px; color: var(--accent); opacity:.85; flex-shrink:0; }
.mobile-menu .m-sub{ display:flex; flex-wrap:wrap; gap:8px; padding:12px 6px 4px 37px; }
.mobile-menu .m-sub a{ font-size:12px; color: var(--text-secondary); border:1px solid var(--border); border-radius:20px; padding:6px 12px; font-family: var(--mono); }
.mobile-menu .m-sub a:hover{ color: var(--accent); border-color: var(--border-strong); }
.mobile-social{ display:flex; gap:8px; margin-top:26px; }

@media (max-width:1300px){ .nav-links{ display:none; } .nav-toggle{ display:flex; } .nav-right .icon-btn:nth-child(n+4){ display:none; } }
@media (min-width:1301px){ .mobile-menu{ display:none !important; } }
@media (max-width:560px){ .site-nav{ padding:14px 18px; } .nav-right .icon-btn{ display:none; } }
</style>
