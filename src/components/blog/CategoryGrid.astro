---
/**
 * GRADE DAS 8 CATEGORIAS.
 *
 * A contagem de artigos e calculada da collection, nao escrita a mao. No
 * prototipo em HTML os numeros eram fixos no template e envelheciam sozinhos.
 */
import { categories } from '../../data/categories';

interface Props {
  counts: Record<string, number>;
}
const { counts } = Astro.props;
---

<h2 class="sr-only">Categorias do blog</h2>
<div class="cat-grid">
  {categories.map((c) => (
    <a class:list={['cat-card', c.variant === 'rust' && 'rust']} href={`/blog/categoria/${c.slug}`}>
      <span class="cc-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.icon} />
      </span>
      <h3>{c.name}</h3>
      <p>{c.description}</p>
      <span class="cc-count">{counts[c.slug] ?? 0} {counts[c.slug] === 1 ? 'artigo' : 'artigos'}</span>
    </a>
  ))}
</div>

<style is:global>
.cat-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-top:34px; }
.cat-card{ display:flex; flex-direction:column; gap:9px; background: var(--bg-elev); border:1px solid var(--border); border-radius:13px; padding:20px; transition: border-color .16s ease, background .16s ease, transform .16s ease; }
.cat-card:hover{ border-color: var(--accent-dim); background: var(--bg-elev-2); transform: translateY(-2px); }
.cat-card .cc-icon{ width:34px; height:34px; display:flex; align-items:center; justify-content:center; border-radius:9px; background: rgba(217,164,65,0.18); color: var(--accent-ink); }
.cat-card .cc-icon svg{ width:18px; height:18px; }
.cat-card.rust .cc-icon{ background: rgba(193,87,58,0.16); color: var(--rust-ink); }
.cat-card h3{ font-size:15px; font-weight:600; line-height:1.3; }
.cat-card:hover h3{ color: var(--accent-ink); }
.cat-card.rust:hover h3{ color: var(--rust-ink); }
.cat-card p{ font-size:12.5px; line-height:1.55; color: var(--text-muted); }
.cat-card .cc-count{ font-family: var(--mono); font-size:10.5px; text-transform:uppercase; letter-spacing:0.08em; color: var(--text-muted); margin-top:auto; padding-top:8px; }
@media (max-width:1080px){ .cat-grid{ grid-template-columns:repeat(3,1fr); } }
@media (max-width:860px){ .cat-grid{ grid-template-columns:repeat(2,1fr); } }
@media (max-width:620px){ .cat-grid{ grid-template-columns:1fr; } }
</style>
