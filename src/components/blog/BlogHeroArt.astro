---
/**
 * ARTE DO HERO DE /blog: a arquitetura de conteudo do site em SVG inline.
 *
 * Nao pesa requisicao e nao entra no LCP como imagem externa. Se virar imagem
 * real, ela e a unica da pagina sem loading lazy.
 */
---

<figure class="hero-art">
  <svg viewBox="0 0 520 340" role="img" aria-labelledby="heroArtTitle heroArtDesc">
    <title id="heroArtTitle">Arquitetura de conteúdo do blog</title>
    <desc id="heroArtDesc">Uma pilar page no topo conectada por linhas pontilhadas a artigos de apoio agrupados em clusters.</desc>
    <rect x="150" y="26" width="220" height="58" rx="12" fill="#251A0F" stroke="#D9A441" stroke-width="1.6"/>
    <text x="260" y="52" text-anchor="middle" fill="#F0E4CF" font-family="JetBrains Mono, monospace" font-size="12">PILAR PAGE</text>
    <text x="260" y="70" text-anchor="middle" fill="#9A8260" font-family="JetBrains Mono, monospace" font-size="10">/blog/seo-tecnico</text>

    <g stroke="#D9A441" stroke-width="1.4" stroke-dasharray="4 6" opacity=".65" fill="none">
      <path d="M260 84v34"/>
      <path d="M260 118H86v30M260 118h174v30M260 118v30"/>
    </g>

    <g fill="#1C130B" stroke="rgba(216,182,138,0.26)" stroke-width="1">
      <rect x="26" y="148" width="120" height="52" rx="10"/>
      <rect x="200" y="148" width="120" height="52" rx="10"/>
      <rect x="374" y="148" width="120" height="52" rx="10"/>
    </g>
    <g fill="#B39A78" font-family="Space Grotesk, sans-serif" font-size="11" text-anchor="middle">
      <text x="86" y="172">Crawl e indexação</text>
      <text x="86" y="188" fill="#6E5A42" font-family="JetBrains Mono, monospace" font-size="9">cluster 01</text>
      <text x="260" y="172">Core Web Vitals</text>
      <text x="260" y="188" fill="#6E5A42" font-family="JetBrains Mono, monospace" font-size="9">cluster 02</text>
      <text x="434" y="172">Dados estruturados</text>
      <text x="434" y="188" fill="#6E5A42" font-family="JetBrains Mono, monospace" font-size="9">cluster 03</text>
    </g>

    <g stroke="#9C7226" stroke-width="1.1" stroke-dasharray="3 6" opacity=".5" fill="none">
      <path d="M86 200v26M260 200v26M434 200v26"/>
      <path d="M50 226h72M224 226h72M398 226h72"/>
      <path d="M50 226v24M122 226v24M224 226v24M296 226v24M398 226v24M470 226v24"/>
    </g>
    <g fill="#251A0F" stroke="rgba(216,182,138,0.18)" stroke-width="1">
      <rect x="26" y="250" width="48" height="26" rx="7"/><rect x="98" y="250" width="48" height="26" rx="7"/>
      <rect x="200" y="250" width="48" height="26" rx="7"/><rect x="272" y="250" width="48" height="26" rx="7"/>
      <rect x="374" y="250" width="48" height="26" rx="7"/><rect x="446" y="250" width="48" height="26" rx="7"/>
    </g>
    <g fill="#6E5A42" font-family="JetBrains Mono, monospace" font-size="9" text-anchor="middle">
      <text x="50" y="267">post</text><text x="122" y="267">post</text>
      <text x="224" y="267">post</text><text x="296" y="267">post</text>
      <text x="398" y="267">post</text><text x="470" y="267">post</text>
    </g>

    <g opacity=".85">
      <circle cx="446" cy="60" r="22" fill="none" stroke="#C1573A" stroke-width="1.6"/>
      <path d="M462 76l16 16" stroke="#C1573A" stroke-width="3.2" stroke-linecap="round"/>
    </g>
    <text x="260" y="316" text-anchor="middle" fill="#6E5A42" font-family="JetBrains Mono, monospace" font-size="10">categoria = navegação · pilar = ranking</text>
  </svg>
  <figcaption>Como o conteúdo daqui é organizado, na prática</figcaption>
</figure>
