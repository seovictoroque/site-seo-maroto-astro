---
/**
 * ANALISAR ESTE CONTEUDO COM IA.
 *
 * Cada botao monta um prompt com o titulo e a URL canonica da pagina. Sao
 * `button` e nao link de proposito: sem JavaScript eles ficam inertes, e um
 * link morto seria pior que um botao inerte.
 *
 * A cor do monograma vem de `style` inline porque e dado, nao estilo: sao
 * oito cores de marca vindas de src/data/ai-tools.ts. A alternativa seria
 * oito classes CSS que precisariam ser editadas junto com o arquivo de dados.
 */
import { aiTools } from '../../data/ai-tools';

interface Props {
  pageTitle: string;
  pageUrl: string;
}
const { pageTitle, pageUrl } = Astro.props;
---

<section
  class="ai-tools"
  aria-labelledby="analisar-ia"
  data-page-title={pageTitle}
  data-page-url={pageUrl}
>
  <h2 id="analisar-ia">Analisar este conteúdo com IA:</h2>
  <p>Abre a ferramenta com um prompt pronto pedindo resumo, pontos fracos e o que checar no seu próprio site.</p>
  <div class="at-row">
    {aiTools.map((tool) => (
      <button
        class="at-btn"
        type="button"
        data-tpl={tool.url}
        data-copy={tool.copy ? '1' : undefined}
      >
        <span class="at-mark" style={`background:${tool.color}`} aria-hidden="true">{tool.mark}</span>
        {tool.name}
      </button>
    ))}
  </div>
  <p class="at-status" role="status" aria-live="polite"></p>
</section>

<script>
  import { initAiTools } from '../../scripts/ai-tools';
  initAiTools();
</script>

<style is:global>
/* 12. ANALISAR COM IA ----------------------------------------------------- */
.ai-tools{ margin:26px 0 0; border-top:1px solid var(--border); padding-top:24px; }
.ai-tools h2{ font-family: var(--sans); font-style:normal; font-size:13px; font-weight:600; margin:0 0 4px; color: var(--text-primary); }
.ai-tools p{ font-family: var(--mono); font-size:11.5px; color: var(--text-muted); margin:0 0 14px; line-height:1.6; }
.ai-tools .at-row{ display:flex; flex-wrap:wrap; gap:8px; }
.at-btn{ display:inline-flex; align-items:center; gap:8px; background: var(--bg-elev-2); border:1px solid var(--border-strong); border-radius:9px; padding:8px 13px 8px 9px; font-size:13px; color: var(--text-primary); cursor:pointer; font-family: var(--sans); transition: border-color .15s ease, background .15s ease, color .15s ease; }
.at-btn:hover{ border-color: var(--accent-dim); color: var(--accent-ink); background: var(--bg-elev); }
.at-btn .at-mark{ width:22px; height:22px; border-radius:6px; display:flex; align-items:center; justify-content:center; font-family: var(--mono); font-size:11px; font-weight:500; color:#F0E4CF; flex-shrink:0; }
.at-status{ font-family: var(--mono); font-size:11.5px; color: var(--accent-ink); margin-top:12px; min-height:17px; }
</style>
